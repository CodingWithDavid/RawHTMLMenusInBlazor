@page "/"

<PageTitle>NexCorp | Navigation</PageTitle>

<nav class="nav-panel @(navOpen ? "is-open" : string.Empty)" aria-label="Main navigation" aria-hidden="@(navOpen ? "false" : "true")">
    <button type="button" class="nav-close" aria-label="Close navigation" @onclick="ToggleNav">
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m6 6 12 12M18 6 6 18" /></svg>
    </button>
    <div class="nav-links-container">
        <a href="resturant-menu" class="nav-link" tabindex="@(navOpen ? 0 : -1)" @onclick="CloseNav">
            <span class="nav-text">Resturant Menu</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 3v5a3 3 0 0 0 6 0V3M7 3v18M20 21V3c-4 2-5 6-5 10h5" /></svg>
        </a>
        <a href="raw-html-multi-select" class="nav-link" tabindex="@(navOpen ? 0 : -1)" @onclick="CloseNav">
            <span class="nav-text">Raw HTML Multi Select</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1" /><rect x="14" y="3" width="7" height="7" rx="1" /><rect x="3" y="14" width="7" height="7" rx="1" /><path d="m14 18 2 2 5-5" /></svg>
        </a>
        <a href="#products" class="nav-link" tabindex="@(navOpen ? 0 : -1)" @onclick="CloseNav">
            <span class="nav-text">Products</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m21 16-9 5-9-5V8l9-5 9 5v8Z" /><path d="m3.3 7.8 8.7 5 8.7-5M12 13v8m4.5-16.5-9 5v5" /></svg>
        </a>
        <a href="#locations" class="nav-link" tabindex="@(navOpen ? 0 : -1)" @onclick="CloseNav">
            <span class="nav-text">Locations</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z" /><circle cx="12" cy="10" r="2.5" /></svg>
        </a>
        <a href="#settings" class="nav-link" tabindex="@(navOpen ? 0 : -1)" @onclick="CloseNav">
            <span class="nav-text">Settings</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7Z" /><path d="m19.4 15 .1.1 1.4 1.1-1.4 2.5-1.7-.7-.2.1-1.5.9-.3 1.8h-2.9l-.3-1.8-1.7-1-1.7.7-1.4-2.5 1.4-1.1v-2l-1.4-1.1 1.4-2.5 1.7.7 1.7-1 .3-1.8h2.9l.3 1.8 1.7 1 1.7-.7 1.4 2.5-1.4 1.1v2Z" transform="translate(-1.5 -1.5) scale(1.125)" /></svg>
        </a>
        <a href="#contact" class="nav-link" tabindex="@(navOpen ? 0 : -1)" @onclick="CloseNav">
            <span class="nav-text">Contact Us</span>
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M21 16.5v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 1.1 3.7 2 2 0 0 1 3.1 1.5h3a2 2 0 0 1 2 1.7c.1 1 .4 2 .7 2.9a2 2 0 0 1-.5 2.1L7 9.5a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.5c.9.3 1.9.6 2.9.7a2 2 0 0 1 1.7 2.1Z" /></svg>
        </a>
    </div>
</nav>

<main class="main-content @(navOpen ? "is-shifted" : string.Empty)">
    <button type="button" class="open-nav" aria-expanded="@navOpen" @onclick="ToggleNav">
        <span class="open-nav-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 7h16M4 12h16M4 17h16" /></svg></span>
        @(navOpen ? "Close Navigation" : "Open Navigation")
    </button>
</main>

@code {
    private bool navOpen;

    private void ToggleNav() => navOpen = !navOpen;

    private void CloseNav() => navOpen = false;
}
